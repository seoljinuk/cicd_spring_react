# frontend/DockerfileReact

FROM node:18 as build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build


FROM nginx:alpine

# build 결과 복사
COPY --from=build /app/dist /usr/share/nginx/html

# nginx.conf 복사 추가 ★★★★★
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]