# frontend/Dockerfile

FROM node:18 as build

WORKDIR /app
COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
=====================================================
파일명 : D:\spring_react\spring_coffee\DockerfileSpring
=====================================================
# backend/Dockerfile

FROM openjdk:21-jdk-slim

WORKDIR /app
COPY target/*.jar app.jar

ENTRYPOINT ["java", "-jar", "app.jar"]
=====================================================
파일명 : D:\spring_react\docker-compose.yml
=====================================================
services:
  mysql:
    image: mysql:8
    container_name: mysql-container
    environment:
      MYSQL_ROOT_PASSWORD: My@Sql01
      MYSQL_DATABASE: coffee
    ports:
      - "3306:3306"
    volumes:
      - mysql-data:/var/lib/mysql

  backend:
    build: 
      context: ./spring_coffee
      dockerfile: DockerfileSpring
    container_name: spring-container
    depends_on:
      - mysql
    environment:
      SPRING_DATASOURCE_URL: jdbc:mysql://mysql:3306/coffee
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: My@Sql01
    ports:
      - "9000:9000"

  frontend:
    build: 
      context: ./react_coffee
      dockerfile: DockerfileReact
    container_name: react-container

  nginx:
    image: nginx:alpine
    container_name: nginx-container
    depends_on:
      - backend
      - frontend
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf
      - ./frontend/build:/usr/share/nginx/html

volumes:
  mysql-data:
